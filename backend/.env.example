# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fikirhane
PORT=8080
# Comma-separated browser origins allowed to call the API with credentials (the GitHub Pages site, etc.).
CORS_ORIGINS=https://pelamx.github.io
# Lax when the site is served by this backend (same origin); None when the site is on another origin (requires HTTPS).
COOKIE_SAMESITE=Lax
COOKIE_SECURE=true
# pay_at_venue: priced bookings are confirmed with payment_status=unpaid. online: pending_payment hold (needs a payment provider).
PAYMENT_MODE=pay_at_venue
# Directory of the static site served at / (the repository root). Leave empty to serve the API only.
SITE_DIR=..
# Visitor (no active membership) booking policy.
VISITOR_RESERVATION_WINDOW_DAYS=7
VISITOR_MAX_ACTIVE_BOOKINGS=2
MEMBERSHIP_PERIOD_MONTHS=12
# Trust X-Forwarded-For (only behind your own reverse proxy / load balancer)
TRUST_PROXY=false
# Forgot password emails. Resend works over HTTPS (Render's free plan blocks SMTP). Without a key, production sends no
# email and the forgot-password page tells people to ask the Fikirhane team, who can create a link in the admin panel.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend account email.
MAIL_FROM=Fikirhane <onboarding@resend.dev>
# Public site address for emailed links (Render sets RENDER_EXTERNAL_URL, which is used when this is empty).
PUBLIC_SITE_URL=
PASSWORD_RESET_MINUTES=60
